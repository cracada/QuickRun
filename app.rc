#pragma code_page(65001)
#include <windows.h>

/* ---- 图标和 manifest ---- */
1 ICON "app.ico"
1 24 "app.manifest"
1005 RCDATA "QuickRun.md"

/* ---- 版本信息块 ---- */
1 VERSIONINFO
 FILEVERSION 1,2,0,50
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "CR"
            VALUE "FileDescription", "QuickRun 快速启动器"
            VALUE "FileVersion", "1.2.0.50"
            VALUE "InternalName", "QuickRun"
            VALUE "LegalCopyright", "Copyright (C) 2026 CR"
            VALUE "OriginalFilename", "QuickRun.exe"
            VALUE "ProductName", "QuickRun"
            VALUE "ProductVersion", "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END